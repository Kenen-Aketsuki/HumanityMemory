#!/bin/sh
# ---------------------------------------------------------------------------
# pre-commit: 禁止把「本地专用工具」与「记忆库」提交进版本库
#
# 拦截范围（暂存区路径命中即拦截）：
#   1. 任何含 ExternalCommandSystem 的路径（含 Unity 生成的 .meta）
#   2. .workbuddy/ 下的全部内容（记忆 Markdown、离线编译脚本等）
#   3. .ai_memory/ 下的全部内容（记忆库 db、令牌文件）
#
# 为什么连 .db 也要拦：
#   记忆库是二进制文件，一旦入库每次写入都会产生巨大 diff，
#   而且里面可能残留对话内容。备份应该走 `humanity-memory export`
#   导出成 Markdown，或者单独同步 .ai_memory/ 目录。
#
# 说明：
#   - 本钩子只读暂存区，不修改任何文件。
#   - 确有例外时用 `git commit --no-verify` 绕过（会跳过全部钩子，谨慎）。
#   - 纯 POSIX sh 写法，不依赖 bash 扩展。
# ---------------------------------------------------------------------------

set -u

# 仅在终端输出时着色，避免重定向时留下转义码
if [ -t 1 ]; then
    RED=$(printf '\033[31m'); YEL=$(printf '\033[33m')
    DIM=$(printf '\033[2m'); BOLD=$(printf '\033[1m'); RST=$(printf '\033[0m')
else
    RED=''; YEL=''; DIM=''; BOLD=''; RST=''
fi

tmp_all=$(mktemp) || exit 0
tmp_bad=$(mktemp) || { rm -f "$tmp_all"; exit 0; }
trap 'rm -f "$tmp_all" "$tmp_bad"' EXIT INT TERM HUP

# 暂存区中：新增/复制/修改/重命名/类型变更（删除 D 不拦）
# core.quotepath=false 保证中文路径原样输出
git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMRT > "$tmp_all" 2>/dev/null

total=0
while IFS= read -r f; do
    [ -n "$f" ] || continue
    total=$((total + 1))
    case "$f" in
        *ExternalCommandSystem*|*/.workbuddy/*|.workbuddy/*|*/.ai_memory/*|.ai_memory/*)
            printf '%s\n' "$f" >> "$tmp_bad"
            ;;
    esac
done < "$tmp_all"

if [ -s "$tmp_bad" ]; then
    count=$(wc -l < "$tmp_bad" | tr -d ' ')
    printf '%s\n' "${BOLD}${RED}提交被阻止：暂存区包含本地专用工具或记忆库文件${RST}"
    printf '\n'
    printf '%s\n' "${RED}以下 ${count} 个文件不允许提交（本次共检查 ${total} 个暂存文件）：${RST}"
    sed 's/^/    - /' "$tmp_bad"
    printf '\n'
    printf '%s\n' "${YEL}处理方式（任选其一）：${RST}"
    printf '%s\n' "  1) 取消暂存：${DIM}git restore --staged <上述路径>${RST}"
    printf '%s\n' "  2) 加入本地忽略（不进版本库、不影响协作者）—— 编辑 ${DIM}.git/info/exclude${RST}"
    printf '%s\n' "     /Assets/Editor/ExternalCommandSystem/"
    printf '%s\n' "     /Assets/Editor/ExternalCommandSystem.meta"
    printf '%s\n' "     /.workbuddy/"
    printf '%s\n' "     /.ai_memory/"
    printf '%s\n' "  3) 确实要提交（不推荐）：${DIM}git commit --no-verify${RST}"
    printf '\n'
    exit 1
fi

# 附加检查：受保护路径中是否已有文件被跟踪（历史遗留），只警告不阻止
tracked=$(git ls-files 2>/dev/null | grep -iE '(ExternalCommandSystem|\.workbuddy/|\.ai_memory/)' | head -5)
if [ -n "$tracked" ]; then
    printf '%s\n' "${YEL}[警告] 受保护路径中已有文件被 git 跟踪（历史遗留，本次未改动）：${RST}"
    printf '%s\n' "$tracked" | sed 's/^/    ! /'
    printf '%s\n' "${DIM}      如需移出版本库：git rm --cached <路径>（请自行确认后执行）${RST}"
    printf '\n'
fi

exit 0
