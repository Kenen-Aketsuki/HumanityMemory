# ============================================================
# HumanityMemory 配置样例
# 复制为 .env，放在项目根目录或 ~/.humanity-memory/.env
# 真实环境变量优先级高于本文件
# ============================================================

# ---------- 存储 ----------
# 全局库目录（跨项目事实 + 全局信条），默认 ~/.humanity-memory
# 配置也建议放这里：$HM_HOME/.env —— 换目录也能读到
# HM_HOME=C:/Users/you/.humanity-memory

# 显式指定工作区根目录，跳过从 cwd 向上查找
# HM_WORKSPACE=D:/proj/SomeProject

# ---------- Embedding（OpenAI 兼容 /v1/embeddings）----------
# 不配置也能用：退化为关键词检索（trigram + bigram 兜底）。

# 【推荐】硅基流动 —— BAAI/bge-m3 为价格页标注的免费模型，需实名认证，有限速
# 注册：https://cloud.siliconflow.cn  →  API 密钥
HM_EMBED_BASE_URL=https://api.siliconflow.cn/v1
HM_EMBED_API_KEY=
HM_EMBED_MODEL=BAAI/bge-m3
HM_EMBED_DIM=1024

# 【备选】智谱 BigModel —— 新用户送 2000 万 tokens，无需实名，中文优化
# 注册：https://bigmodel.cn/usercenter/apikeys
# HM_EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# HM_EMBED_API_KEY=
# HM_EMBED_MODEL=embedding-3
# HM_EMBED_DIM=2048

# 【备选】本地 Ollama —— 完全离线零成本，接口同为 OpenAI 兼容
# 先 `ollama pull bge-m3`，再改成：
# HM_EMBED_BASE_URL=http://127.0.0.1:11434/v1
# HM_EMBED_MODEL=bge-m3
# HM_EMBED_DIM=1024

# 【备选】OpenAI
# HM_EMBED_BASE_URL=https://api.openai.com/v1
# HM_EMBED_API_KEY=sk-xxxx
# HM_EMBED_MODEL=text-embedding-3-small
# HM_EMBED_DIM=1536

# 单次请求最多几条文本（免费模型限速严时调小到 8~16 更稳）
# HM_EMBED_BATCH=32
# 请求超时（秒）
# HM_EMBED_TIMEOUT=30

# ---------- 检索权重（三项之和建议为 1）----------
# HM_W_RETRIEVAL=0.72
# HM_W_IMPORTANCE=0.12
# HM_W_STRENGTH=0.16

# ---------- 生命周期 ----------
# 半衰期（天）：事实几乎不忘，经历慢，日志快
# HM_HALFLIFE_FACT=3650
# HM_HALFLIFE_EPISODE=180
# HM_HALFLIFE_LOG=14

# 全局事实超过这个数量时 stats 会提示整理（跨项目事实本该很少）
# HM_GLOBAL_FACTS_WARN=50

# 归档判据：超过 TTL 天没被碰过、且访问次数不超过 max_access → 归档（可逆）
# HM_ARCHIVE_TTL_FACT=1095      # 事实 3 年
# HM_ARCHIVE_TTL_EPISODE=540    # 经历 1.5 年
# HM_ARCHIVE_MAX_ACCESS=1

# 归档后静默多少天算「删除候选」（只报告，不会自动删）
# HM_PURGE_AFTER_DAYS=180

# ---------- 其它 ----------
# 手动指定 sqlite-vec 扩展路径（pip 加载失败时兜底）
# HM_VEC_EXTENSION=D:/proj/HumanityMemory/tools/bin/vec0.dll
