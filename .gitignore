# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# --- 本地数据 ---
*.db
*.db-wal
*.db-shm
.data/
.env

# --- 本机路径（每台机器不同，只有 local.env.example 入库）---
local.env

# --- 记忆库工作区（令牌含工作区绑定与可选凭据，绝不入库）---
.ai_memory/
**/memory.token.json
**/active.token.json
*.token.json

# --- 客户端本地目录（本项目记忆已走 .ai_memory，不再用 .workbuddy/memory）---
.workbuddy/

# --- 随项目附带的三方二进制（体积大，按需下载）---
tools/bin/

# --- 发布产物（打包出来的 exe 与库快照，一律不入库；源码 upgrade/ 才是可回滚的凭据）---
release/

# --- 安装位置的配置（config template 生成，属于这台机器的这套安装，不随仓库走）---
/memory.toml

# --- 编辑器 ---
.vscode/
.idea/
.DS_Store
