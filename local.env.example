# Example local path config. Copy to local.env and fill in (local.env is ignored by git).
# Keep ASCII-only and CRLF: cmd.exe reads this file as GBK.

# Release root. On this machine, outside the project tree
# (a sibling dir is fine, e.g. project at D:/work/myproj -> D:/work/myproj-release).
HM_RELEASE_ROOT=

# Dev workspace for source-state testing. Never point at the production db.
HM_DEV_ROOT=

# Roots scanned by the batch upgrade tool, comma separated.
HM_SCAN_ROOTS=
